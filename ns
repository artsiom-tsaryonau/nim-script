#!/usr/bin/env bash
# ns — jbang-style Nim scripts (nim-script)
#
# Requires Bash 4.3+ (nameref). Fedora and Homebrew bash are fine;
# stock macOS /bin/bash 3.2 is not — put Bash 4.3+ first on PATH.
#
#   //DEPS requires:jsony
#   //DEPS gh:owner/repo/ref
#   //DEPS gh:owner/repo/ref AS pkgname
#   //DEPS git:https://gitlab.com/user/repo.git#ref
#
# NIM / NIMBLE — compiler and nimble commands (default: on PATH).
#
# CWD: binary runs with cwd = the directory where you invoked ns.
#      NS_CWD is also set to that path.
#
set -euo pipefail

if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 3))); then
    echo "ns: need Bash 4.3+ (found $BASH_VERSION); ensure #!/usr/bin/env bash resolves to it" >&2
    exit 1
fi

die() { echo "ns: $*" >&2; exit 1; }
die_usage() { echo "$*" >&2; usage; exit 2; }

usage() {
    cat <<'EOF' >&2
usage:
  ns <script.nim> [args...]
  ns clean <script>|--all
  ns env init [dir]
  ns env activate [dir]
  ns selfcheck
  ns help
EOF
}

[[ $# -ge 1 ]] || die_usage "missing arguments"

CALLER_PWD="$(pwd -P)"

sha() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$@" | awk '{print $1}'
    else
        openssl dgst -sha256 "$@" | awk '{print $NF}'
    fi
}

readonly DEPS_RE='^[[:space:]]*//DEPS[[:space:]]+([^[:space:][]+)(\[([^]]*)\])?([[:space:]]+AS[[:space:]]+([^[:space:]]+))?[[:space:]]*$'

deps_fingerprint() {
    local script=$1 lines
    lines=$(grep -E "$DEPS_RE" "$script" 2>/dev/null | LC_ALL=C sort || true)
    [[ -n "$lines" ]] || { printf '-'; return 0; }
    if command -v sha256sum >/dev/null 2>&1; then
        printf '%s' "$lines" | sha256sum | awk '{print $1}'
    else
        printf '%s' "$lines" | openssl dgst -sha256 | awk '{print $NF}'
    fi
}

resolve_ns_root() {
    if [[ -n "${NS_ROOT:-}" ]]; then
        printf '%s' "$NS_ROOT"
    elif [[ -d "$CALLER_PWD/.ns" ]]; then
        printf '%s' "$CALLER_PWD/.ns"
    else
        printf ''
    fi
}

cache_base() {
    if [[ -n "${NS_CACHE:-}" ]]; then
        printf '%s' "$NS_CACHE"
    else
        local root
        root="$(resolve_ns_root)"
        if [[ -n "$root" ]]; then
            printf '%s' "$root/cache"
        else
            printf '%s' "${XDG_CACHE_HOME:-$HOME/.cache}/nim-script"
        fi
    fi
}

maybe_isolate_nim() {
    local root
    root="$(resolve_ns_root)"
    [[ -n "$root" ]] || return 0
    export NS_ROOT="$root"
}

script_cache_dir() {
    local script=$1
    printf '%s/%s' "$(cache_base)" "$(printf '%s' "$script" | sha)"
}

abspath_script() {
    local p=$1
    [[ -f "$p" ]] || die "not a file: $p"
    printf '%s/%s' "$(cd "$(dirname "$p")" && pwd -P)" "$(basename "$p")"
}

read_stamp() {
    local f=$1
    [[ -f "$f" ]] || return 1
    local s
    s=$(<"$f")
    s=${s%"${s##*[![:space:]]}"}
    printf '%s' "$s"
}

_NS_LOCK=
release_lock() {
    [[ -n "${_NS_LOCK:-}" ]] || return 0
    rmdir "$_NS_LOCK" 2>/dev/null || true
    _NS_LOCK=
}
# ponytail: mkdir lock per script cache; rm .ns_lock manually if a build crashed mid-flight.
acquire_lock() {
    local lock=$1
    if mkdir "$lock" 2>/dev/null; then
        _NS_LOCK=$lock
        trap release_lock EXIT
        return 0
    fi
    die "locked ($lock) — another ns is building this script"
}

find_tool() {
    local override=$1; shift
    local name path
    for name in "$@"; do
        if [[ -n "$override" ]]; then
            path="$(type -P "$override")" || die "'$override' not found on PATH"
            printf '%s' "$path"
            return 0
        fi
        path="$(type -P "$name")" || continue
        printf '%s' "$path"
        return 0
    done
    return 1
}

tool_ver() {
    local bin=$1
    shift
    "$bin" "$@" 2>/dev/null | head -n1 || printf '?'
}

isolated_home() {
    printf '%s/home' "$ROOT"
}

# ponytail: isolated HOME per script cache; no cross-script nimble pkg dedup.
run_isolated() {
    local home
    home="$(isolated_home)"
    mkdir -p "$home"
    NIMBLE_SILENCE_WARNINGS=1 NIMBLE_NO_COLOR=1 HOME="$home" "$@"
}

run_nimble() {
    run_isolated "$1" "${@:2}"
}

run_nim() {
    run_isolated "$1" "${@:2}"
}

# REQUIRES: lines for package.nimble
REQUIRES=()

add_deps_ref() {
    local raw=$1 _as=${2:-} opts=${3:-}
    local kind ref owner repo tag req

    case "$raw" in
        requires:*) kind=requires; ref=${raw#requires:} ;;
        gh:*)       kind=gh;      ref=${raw#gh:} ;;
        git:*)      kind=git;     ref=${raw#git:} ;;
        *) die "//DEPS needs requires:, gh:, or git: prefix — got: $raw" ;;
    esac
    [[ -n "$opts" ]] && die "ns: dependency options [...] not supported yet: $raw"

    if [[ "$kind" == requires ]]; then
        REQUIRES+=("$ref")
        return 0
    fi

    if [[ "$kind" == git ]]; then
        [[ "$ref" == http* ]] || die "git: must be a full URL (https://...#ref) — got: $ref"
        REQUIRES+=("$ref")
        return 0
    fi

    local n
    n=$(awk -F/ '{print NF}' <<<"$ref")
    if [[ "$n" -eq 3 ]]; then
        owner=${ref%%/*}; ref=${ref#*/}
        repo=${ref%%/*}; tag=${ref#*/}
        req="https://github.com/${owner}/${repo}#${tag}"
        REQUIRES+=("$req")
        return 0
    fi
    die "gh: ref needs owner/repo/ref — got: $ref"
}

write_nimble() {
    cat >package.nimble <<'EOF'
version       = "0.0.1"
author        = "ns"
description   = "ephemeral nim-script package"
license       = "MIT"

requires "nim >= 2.0.0"
EOF
    local r
    for r in ${REQUIRES[@]+"${REQUIRES[@]}"}; do
        printf 'requires "%s"\n' "$r" >>package.nimble
    done
}

nim_build_plain() {
    local nim_bin=$1
    "$nim_bin" c -o:script --mm:orc --hints:off script.nim
}

nim_build_with_deps() {
    local nim_bin=$1 nimble_bin=$2
    write_nimble
    run_nimble "$nimble_bin" install --depsOnly -y
    run_nim "$nim_bin" c -o:script --mm:orc --hints:off script.nim
}

# --- subcommands -------------------------------------------------------------

cmd_help() { usage; exit 0; }

cmd_clean() {
    local target=${1:-}
    [[ -n "$target" ]] || die_usage "usage: ns clean <script>|--all"
    maybe_isolate_nim
    if [[ "$target" == --all ]]; then
        local base
        base="$(cache_base)"
        echo "ns: removing $base"
        rm -rf "$base"
        exit 0
    fi
    local script dir
    script="$(abspath_script "$target")"
    dir="$(script_cache_dir "$script")"
    echo "ns: removing $dir"
    rm -rf "$dir"
    exit 0
}

cmd_env_init() {
    local dir=${1:-$CALLER_PWD}
    mkdir -p "$dir"
    dir="$(cd "$dir" && pwd -P)"
    local root="$dir/.ns"
    mkdir -p "$root/cache"
    cat >"$root/activate" <<'EOF'
# usage: source .ns/activate
_NS="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd -P)"
export NS_ROOT="$_NS"
export NS_CACHE="$_NS/cache"
mkdir -p "$NS_CACHE"
echo "ns: env $_NS" >&2
EOF
    echo "ns: initialized $root"
    echo "ns:   source $root/activate"
    echo "ns:   add .ns/ to .gitignore"
    exit 0
}

cmd_env_activate() {
    local dir=${1:-$CALLER_PWD}
    dir="$(cd "$dir" && pwd -P)"
    local root="$dir/.ns"
    [[ -d "$root" ]] || die "no $root — run: ns env init"
    cat <<EOF
export NS_ROOT=$(printf '%q' "$root")
export NS_CACHE=$(printf '%q' "$root/cache")
mkdir -p "\$NS_CACHE"
EOF
    exit 0
}

cmd_env() {
    local sub=${1:-}
    shift || true
    case "$sub" in
        init)     cmd_env_init "$@" ;;
        activate) cmd_env_activate "$@" ;;
        *) die_usage "usage: ns env init|activate [dir]" ;;
    esac
}

cmd_selfcheck() {
    local tmp failures=0 out nim_bin
    tmp="$(mktemp -d "$CALLER_PWD/.ns-selfcheck.XXXXXX")"
    trap 'rm -rf -- '"$(printf '%q' "$tmp")" EXIT

    echo "ns: bash $BASH_VERSION"
    nim_bin="$(find_tool "${NIM:-}" nim)" || { echo "ns: nim not found" >&2; exit 1; }
    echo "ns: ok nim -> $nim_bin ($(tool_ver "$nim_bin" --version))"

    local re line
    re="$DEPS_RE"
    line='//DEPS requires:jsony'
    if [[ "$line" =~ $re ]] && [[ "${BASH_REMATCH[1]}" == "requires:jsony" ]]; then
        echo "ns: ok //DEPS parse"
    else
        echo "ns: //DEPS parse failed" >&2
        failures=1
    fi

    cat >"$tmp/hi.nim" <<'EOF'
echo "ok"
EOF
    out="$(NS_CACHE="$tmp/cache" "$0" "$tmp/hi.nim" 2>/dev/null || true)"
    if [[ "$out" == "ok" ]]; then
        echo "ns: ok no-deps compile+run"
    else
        echo "ns: no-deps compile+run failed" >&2
        NS_CACHE="$tmp/cache" "$0" "$tmp/hi.nim" >&2 || true
        failures=1
    fi

    [[ $failures -eq 0 ]] || exit 1
    echo "ns: selfcheck passed"
    exit 0
}

case "$1" in
    help|-h|--help) cmd_help ;;
    clean) shift; cmd_clean "$@" ;;
    env) shift; cmd_env "$@" ;;
    selfcheck) cmd_selfcheck ;;
esac

# --- run script --------------------------------------------------------------

maybe_isolate_nim

SCRIPT="$(abspath_script "$1")"
shift
[[ "${SCRIPT##*.}" == nim ]] || die "unsupported extension (use .nim)"

NIM_BIN="$(find_tool "${NIM:-}" nim)" || die "nim not found on PATH (install nim or set NIM)"
NIMBLE_BIN="$(find_tool "${NIMBLE:-}" nimble)" || true

HOST="$(uname -s)-$(uname -m)"
STAMP_NIM="${NIM_BIN}@$(tool_ver "$NIM_BIN" --version)"
STAMP_NIMBLE=""
[[ -n "$NIMBLE_BIN" ]] && STAMP_NIMBLE="${NIMBLE_BIN}@$(tool_ver "$NIMBLE_BIN" --version)"

ROOT="$(script_cache_dir "$SCRIPT")"
mkdir -p "$ROOT"
cd "$ROOT"

CONTENT_HASH="$(sha "$SCRIPT")"
DEPS_FP="$(deps_fingerprint "$SCRIPT")"
# ponytail: stamp hashes //DEPS lines, not resolved package versions; bump a dep line or ns clean to refresh.
STAMP="${CONTENT_HASH}|${DEPS_FP}|${HOST}|${STAMP_NIM}|${STAMP_NIMBLE}"
BIN="$ROOT/script"

prepare_run_env() {
    export NS_CWD="$CALLER_PWD"
}

run_bin() {
    prepare_run_env
    cd "$CALLER_PWD"
    exec "$BIN" "$@"
}

is_warm() {
    local cur
    cur="$(read_stamp "$ROOT/.ns_stamp")" || return 1
    [[ "$cur" == "$STAMP" && -x "$BIN" ]]
}

if is_warm; then
    run_bin "$@"
fi

acquire_lock "$ROOT/.ns_lock"
if is_warm; then
    run_bin "$@"
fi

REQUIRES=()

while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ $DEPS_RE ]] || continue
    add_deps_ref "${BASH_REMATCH[1]}" "${BASH_REMATCH[5]:-}" "${BASH_REMATCH[3]:-}"
done <"$SCRIPT"

sed '1{/^#!/d;}; /^[[:space:]]*\/\/DEPS/d' "$SCRIPT" >script.nim

if [[ ${#REQUIRES[@]} -gt 0 ]]; then
    [[ -n "$NIMBLE_BIN" ]] || die "nimble not found on PATH (needed for //DEPS; install nimble or set NIMBLE)"
    nim_build_with_deps "$NIM_BIN" "$NIMBLE_BIN"
else
    nim_build_plain "$NIM_BIN"
fi

[[ -x "$BIN" ]] || die "build succeeded but binary missing: $BIN"

printf '%s\n' "$STAMP" >.ns_stamp
run_bin "$@"
